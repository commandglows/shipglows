onc la destination : documentation interne → **sg-docs** ; documentation publique ou contenu pour une audience → **sg-content**.\n\nContexte de transmission : explication seule, portée par **sg-help**. Distinction étayée par les contrats publics figés `skills/sg-docs/SKILL.md` et `skills/sg-content/SKILL.md`. Aucune modification ni publication effectuée ; aucun contrôle du runtime installé.","id":"delivery-21","provider_delivery":"unknown","sequence":21,"type":"response"},{"capture_boundary":"broker_stdout_or_coordinator_release","concrete_checkpoint_declared":true,"id":"delivery-22","kind":"Explication comparative enregistrée : sg-help distingue documentation interne sg-docs et contenu public sg-content, sans exécuter de workflow ni modifier de fichiers","protocol_placeholder_fields":[],"provider_delivery":"unknown","sequence":22,"type":"checkpoint"}],"real_subject_observation":true,"refusals":[],"requests":16,"response_evidence":[{"capture_authentication":"not_verified","content_sha256":"f77890856f1993652c6d9f21c2a78d23d5a9b22c0e001aa19b75908e03c323a6","event_id":"delivery-21"}],"response_sensitive_matches":[[]],"run_id":"native-shared-final96-H1-r1-baseline","sealed":true,"started_ns":1791357730005412400,"strict_isolated_pilot_eligible":false,"subject_id":"/root/source_review/final_subject_001","timing_boundary":"preparation_to_coordinator_finalize_only","variant":"baseline"}