ntaire : proposition uniquement ; contenu public et publication hors périmètre. Suite : si une réparation est demandée, préparer le remplacement exact et sa preuve ciblée, puis obtenir l’autorisation de mutation applicable. L’audit reste strictement en lecture seule.","id":"delivery-34","provider_delivery":"unknown","sequence":34,"type":"response"},{"capture_boundary":"broker_stdout_or_coordinator_release","concrete_checkpoint_declared":true,"id":"delivery-35","kind":"Rapport d’audit borné enregistré après lecture des fixtures et préflight puis audit simulés ; constat review expliqué, aucune réparation ou persistance de travail réalisée","protocol_placeholder_fields":[],"provider_delivery":"unknown","sequence":35,"type":"checkpoint"}],"real_subject_observation":true,"refusals":[{"boundary":"mcp_transport","error_sha256":"9ed30738ebeeb18edd572c92bb50ceb06f9bde525f82c80c1a2020074419d731","provider_delivery":"unknown","request_sha256":"e40fe5f02d82770617c5c8af1b7f7941ad3f0aac34f7aa01d786aa43189ff05f"}],"requests":24,"response_evidence":[{"capture_authentication":"not_verified","content_sha256":"6264a51223e1417d4f962b850642763008b301f4252fdc75b6d38e62335bd0c1","event_id":"delivery-19"},{"capture_authentication":"not_verified","content_sha256":"41681d3ae0d0efc64c25337f28e21d6c4e8ba093c9f475c4fc36660baf292809","event_id":"delivery-34"}],"response_sensitive_matches":[[],[]],"run_id":"native-shared-final96-A1-r2-candidate","sealed":true,"started_ns":1791359750719677900,"strict_isolated_pilot_eligible":false,"subject_id":"/root/source_review/final_subject_015","timing_boundary":"preparation_to_coordinator_finalize_only","variant":"candidate"}