# ShipGlows environment variables
# Copy these into your shell/env before launching ShipGlows.

# Core paths
SHIPGLOWS_PROJECTS_DIR=/home/user/shipglows-projects
SHIPGLOWS_DATA_DIR=$HOME/shipglows_data
SHIPGLOWS_LOG_DIR=$HOME/.shipglows/logs
SHIPGLOWS_LOG_FILE=$SHIPGLOWS_LOG_DIR/shipglows.log
SHIPGLOWS_CADDYFILE=/etc/caddy/Caddyfile
SHIPGLOWS_SECRETS_DIR=$HOME/.shipglows
SHIPGLOWS_SESSION_DIR=$SHIPGLOWS_SECRETS_DIR/session

# Port management
SHIPGLOWS_PORT_RANGE_START=3000
SHIPGLOWS_PORT_RANGE_END=3100
SHIPGLOWS_PORT_MAX_ATTEMPTS=100

# SSH tunnel defaults
SHIPGLOWS_SSH_KEEPALIVE_INTERVAL=30
SHIPGLOWS_SSH_KEEPALIVE_MAX=3
SHIPGLOWS_SSH_REMOTE_USER=root
SHIPGLOWS_SSH_REMOTE_HOST=hetzner

# Logging and monitoring
SHIPGLOWS_LOGGING_ENABLED=true
SHIPGLOWS_LOG_RETENTION_DAYS=30
SHIPGLOWS_LOG_LEVEL=INFO
SHIPGLOWS_GITHUB_REPO_LIMIT=500
SHIPGLOWS_PM2_CACHE_ENABLED=true
SHIPGLOWS_PM2_CACHE_TTL=5
SHIPGLOWS_PREFER_JQ=true
SHIPGLOWS_HEALTH_CHECK_ENABLED=true
SHIPGLOWS_CRASH_LOOP_THRESHOLD=10
SHIPGLOWS_UNSTABLE_UPTIME_SECS=30
SHIPGLOWS_DISK_WARN_GB=5
SHIPGLOWS_MENU_STATUS_CACHE_TTL=120
SHIPGLOWS_MEM_WARN_PCT=20
SHIPGLOWS_MEM_CRITICAL_PCT=10
# Optional legacy absolute override; leave empty to scale with VM capacity.
SHIPGLOWS_MEM_WARN_GB=
SHIPGLOWS_PROCESS_LONG_RUNNING_HOURS=24
SHIPGLOWS_MONITOR_TOP_N=15
SHIPGLOWS_SESSION_ENABLED=true

# Screenshot / image upload
SHIPGLOWS_IMGBB_API_KEY=your_imgbb_api_key_here

# Doppler + DataForSEO integration
SHIPGLOWS_DOPPLER_MODE=auto
SHIPGLOWS_ENABLE_DATAFORSEO_MCP=0
SHIPGLOWS_DATAFORSEO_DOPPLER_PROJECT=contentflow_app
SHIPGLOWS_DATAFORSEO_DOPPLER_CONFIG=prd
DATAFORSEO_USERNAME=your_dataforseo_username_here
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# Misc runtime behavior
SHIPGLOWS_SCREENSHOT_EXPIRATION=600
SHIPGLOWS_STRICT_MODE=false
SHIPGLOWS_ERROR_TRAPS=true
