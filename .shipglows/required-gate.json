{
  "production_branch": "main",
  "lanes": [
    {
      "id": "tui-bun",
      "runtime": "shell",
      "root": "tui",
      "paths": [
        "tui/**"
      ],
      "commands": [
        "npm install --global bun@1.3.14",
        "bun install --frozen-lockfile",
        "bun run typecheck",
        "bun test"
      ]
    }
  ]
}
